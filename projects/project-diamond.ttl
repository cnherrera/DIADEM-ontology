# --> Resources used < --    
:BigDFTsim rdf:type proj:SoftwareSystem ;
    rdfs:label "BigDFT"@en ;
    skos:prefLabel "BigDFT"@en ;
    rdfs:comment "BigDFT is an open-source electronic structure code based on density functional theory (DFT) that utilizes Daubechies wavelets as a computational basis. It is designed for ab initio simulations of materials and molecular systems, offering high precision and scalability for large-scale simulations."@en ;
    proj:hasLicense proj:OpenSource ;
    proj:hasURL "https://bigdft.org/index.html"^^xsd:anyURI ;
    proj:isUsedForDevelopment :AtomisticNumericalSimulationDB .

:AiiDA rdf:type proj:SoftwareSystem ;
    rdfs:label "AiiDA Framework"@en ;
    skos:prefLabel "AiiDA"@en ;
    rdfs:comment "AiiDA (Automated Interactive Infrastructure and Database for Computational Science) is an open-source Python framework for managing, preserving, and disseminating computational scientific workflows. It provides automated provenance tracking, data management, and workflow execution capabilities for high-throughput computational materials science."@en ;
    proj:hasLicense proj:OpenSource ;
    proj:isUsedForDevelopment ckey:AiiDAPluginDevelopment ,
                              ckey:AiidaWorkflows ;
    proj:hasSoftwareComponent :AiidaN2p2Plugin .

#proj:Apptainer rdf:type proj:SoftwareSystem ;
#    rdfs:label "Apptainer"@en ;
#    skos:prefLabel "Apptainer"@en ;
#    rdfs:comment "Apptainer is an open-source container platform. It enables users to create and run containers that encapsulate applications and their dependencies, ensuring portability and reproducibility across diverse computing systems."@en ;
#    proj:hasLicense proj:OpenSource .

:Guix rdf:type proj:SoftwareSystem ;
    rdfs:label "GNU Guix"@en ;
    skos:prefLabel "Guix"@en ;
    rdfs:comment "GNU Guix is a functional package manager that facilitates the creation of reproducible and declarative software environments. It allows users to define complete software environments that can be shared and replicated across different systems, enhancing reproducibility in software deployment."@en ;
    proj:hasLicense proj:OpenSource .

:MongoDB rdf:type proj:DatabaseInfrastructure ; # O proj:SoftwareSystem
    rdfs:label "MongoDB Engine"@en ;
    skos:prefLabel "MongoDB"@en ;
    rdfs:comment "MongoDB is a document-oriented NoSQL database that stores data in flexible, JSON-like documents. It offers scalability and flexibility for handling large volumes of unstructured or semi-structured data, making it suitable for modern application development."@en ;
    proj:hasLicense proj:OpenSource ;
    proj:isUsedForDevelopment proj:DiamondDBInfrastructure .


## >>---------------->> Software Produced <<------------------------------

:AiidaN2p2Plugin rdf:type proj:SoftwareComponent ;
    rdfs:label "AiiDA-n2p2 Plugin" ;
    rdfs:comment "An AiiDA plugin for automating the development of Behler-Parrinello neural network MLPs using n2p2, including automated weight selection, validation through LAMMPS molecular dynamics, and semi-automated input generation." ;
    skos:prefLabel "AiiDA-n2p2 Plugin" ;
    proj:isSoftwareComponentOf :AiiDA .




