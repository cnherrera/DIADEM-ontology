:Abinit rdf:type proj:SoftwareSystem ;
    rdfs:label "ABINIT"@en ;
    skos:prefLabel "ABINIT"@en ;
    rdfs:comment "A software suite for electronic structure calculations based on density functional theory, using pseudopotentials and a plane wave or wavelet basis."@en ;
    proj:hasCategory proj:ScientificComputing ;
    proj:hasURL "https://www.abinit.org/"^^xsd:anyURI .

:AbinitContainer rdf:type proj:ContainerImage ;
    rdfs:label "Diamond ABINIT Apptainer Container"@en ;
    rdfs:comment "Apptainer container image of ABINIT built and distributed by the Diamond/DIADEM project for reproducible scientific computing."@en ;
    proj:encapsulatesSoftware :Abinit ;
#    proj:hasDistribution proj:Containerized ;
    proj:usesContainerTechnology proj:Apptainer ;
#    proj:hasAssociatedProject :DiamondProject ;
    proj:hasURL "https://diamond-diadem.github.io/codes/scientific-computing/abinit/"^^xsd:anyURI .


