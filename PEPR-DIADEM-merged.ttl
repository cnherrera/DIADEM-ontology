p_syneart:Project_syneart a proj:AAPProject ;
    rdfs:comment "Ontology representing all entities of the SYNEART project" ;
    skos:prefLabel "SYNEART" ;
    proj:description """Ce projet cherche à révéler le potentiel des matériaux ferroélectriques relaxeurs dont les caractéristiques sont très prometteuses pour la conception de dispositifs nanoélectroniques pour l’informatique neuromorphique. Contrairement aux matériaux ferroélectriques classiques, le domaine des couches minces à base de relaxeurs n'en est qu'à ses débuts. À travers une approche de synthèse combinatoire, des outils de caractérisations structurales, chimiques et électriques haut-débit couplés à des analyses et prédictions basées sur l’intelligence artificielle, nous souhaitons identifier les compositions/épaisseurs/électrodes les plus pertinentes et les utiliser comme briques élémentaires pour concevoir des neurones et des synapses artificiels. Au-delà des matériaux relaxeurs neuromorphiques d’intérêt dans le présent projet, les protocoles de synthèse, caractérisation et prédictions haut débit, et les outils de traitement et d’analyse des données par intelligence artificielle, seront développés ou consolidés pour être mis à disposition de la communauté afin de faciliter et d’accélérer la découverte de nouveaux matériaux dans d’autres domaines et leur mise sur le marché.
""" ;
    proj:endDate "2029-08-31"^^xsd:date ;
    proj:fullName "Artificial synapses and neurons based on ferroelectric relaxors: towards lower-power AI" ;
    proj:gathersCompetence ckey:AIApproaches,
        ckey:CompositionDesign,
        ckey:Heterostructures,
        ckey:HighThroughputSynthesis,
        ckey:MachineLearning,
        ckey:NeuralNetworks,
        ckey:Neuromorphic,
        ckey:PhaseTransformations,
        ckey:RamanSpectroscopy,
        ckey:RelaxorFerroelectric,
        ckey:Spectroscopy,
        ckey:ThinFilm,
        ckey:XRayDiffraction ;
    proj:hasCoordinatingOrganization org:CentraleSupelec ;
    proj:hasCoordinator ppl:BRAHIM_DKHIL ;
    proj:hasPartner org:GREMAN,
        org:IRCER,
        org:LPMC,
        org:SPMS ;
    proj:hasURL "https://www.pepr-diadem.fr/projet/syneart/"^^xsd:anyURI ;
    proj:startDate "2026-03-01"^^xsd:date .

