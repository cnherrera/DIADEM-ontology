@prefix org: <https://cnherrera.github.io/DIADEM-ontology/organizations.ttl#> .
@prefix proj: <https://cnherrera.github.io/DIADEM-ontology/proj-ontology.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://cnherrera.github.io/DIADEM-ontology/organizations.ttl> rdf:type owl:Ontology ;
    rdfs:comment "DIADEM organization instances."@en ;
    owl:imports <https://cnherrera.github.io/DIADEM-ontology/proj-ontology.ttl> ;
    owl:versionInfo "0.1" .


#################################################################
# Organizations
#################################################################
org:ICMCB rdf:type proj:ResearchOrganization ;
    rdfs:label "ICMCB"@en ;
    skos:prefLabel "ICMCB"@en ;
    proj:acronym "ICMCB" ;
    proj:fullName "Institute for Condensed Matter Chemistry of Bordeaux, University Bordeaux"@en ;
    proj:organizationType "Research laboratory" ;
    proj:country "France" .

org:CNRS rdf:type proj:ResearchOrganization ;
