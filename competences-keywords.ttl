@prefix : <https://cnherrera.github.io/DIADEM-ontology/competences-keywords.ttl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix proj: <https://cnherrera.github.io/DIADEM-ontology/proj-ontology.ttl#> .

<https://cnherrera.github.io/DIADEM-ontology/competences-keywords.ttl> a owl:Ontology ;
    rdfs:comment "Instances of Competences and Keywords for DIADEM project"@en ,
                 "Instances de compétences et mots-clés pour le projet DIADEM"@fr ;
    owl:imports <https://cnherrera.github.io/DIADEM-ontology/proj-ontology.ttl> ;
    owl:versionInfo "0.3" .

# =========================================================================
# DEFINITION OF KEYWORD CLASS
# =========================================================================
proj:Keyword rdf:type owl:Class ;
    rdfs:label "Keyword"@en , "Mot-clé"@fr ;
    rdfs:comment "A descriptive keyword or domain term used to categorize topics, materials, or applications."@en ,
                 "Un mot-clé ou terme du domaine utilisé pour catégoriser des sujets, matériaux ou applications."@fr .

# =========================================================================
# 1. Main Competences
# =========================================================================
:ContainerDeployment rdf:type proj:Computational ;
    skos:prefLabel "Scientific Software Containerization"@en , "Conteneurisation de logiciels scientifiques"@fr ;
    rdfs:comment "Packaging and deploying scientific software using container technologies such as Apptainer or Docker."@en ,
                 "Empaquetage et déploiement de logiciels scientifiques via des conteneurs comme Apptainer ou Docker."@fr .

:DatabaseInfrastructureDesign rdf:type proj:DataManagement ;
    skos:prefLabel "Database Infrastructure Design"@en , "Conception d'infrastructure de bases de données"@fr ;
    rdfs:comment "Designing the architecture and implementation of scalable and reliable database systems for scientific workflows."@en ,
                 "Conception de l'architecture de systèmes de bases de données fiables pour les flux scientifiques."@fr .

:HighPerformanceComputing rdf:type proj:Computational ;
    skos:prefLabel "High-performance Computing"@en , "Calcul haute performance"@fr ;
    rdfs:comment "Using and optimizing scientific codes for execution on high-performance computing infrastructures, including GPU clusters and parallel systems."@en ,
                 "Utilisation et optimisation de codes scientifiques pour l'exécution sur des infrastructures HPC et GPU."@fr .

:WorkflowDesign rdf:type proj:Methodological ;
    skos:prefLabel "Workflow Design"@en , "Conception de flux de travail"@fr ;
    rdfs:comment "Structuring scientific and computational procedures into reproducible workflows."@en ,
                 "Structuration de procédures scientifiques en flux de travail reproductibles."@fr .

:AIBasedModelling rdf:type proj:Methodological ;
    skos:prefLabel "AI-based Modelling"@en , "Modélisation basée sur l'IA"@fr ;
    rdfs:comment "Application of artificial intelligence techniques to accelerate and enhance materials modelling and discovery."@en ,
                 "Application de l'IA pour accélérer et améliorer la modélisation et la découverte de matériaux."@fr .

:AtomicSimulation rdf:type proj:Computational ;
    skos:prefLabel "Atomistic Simulation"@en , "Simulation atomistique"@fr ;
    rdfs:comment "Developing and applying atomistic simulation techniques for materials modelling."@en ,
                 "Développement et application de techniques de simulation atomistique pour les matériaux."@fr .

:Containerization rdf:type proj:Computational ;
    skos:prefLabel "Containerization"@en , "Conteneurisation"@fr ;
    rdfs:comment "Using container technologies to encapsulate, distribute, and execute scientific software in reproducible environments."@en ,
                 "Utilisation de conteneurs pour encapsuler et exécuter des logiciels scientifiques."@fr .

:DatabaseInfrastructure rdf:type proj:DataManagement ;
    skos:prefLabel "Database Infrastructure"@en , "Infrastructure de base de données"@fr ;
    rdfs:comment "Building and maintaining backend infrastructure for storing, querying, and scaling access to scientific simulation and experimental data."@en ,
                 "Création et maintenance d'infrastructures backend pour le stockage et l'accès aux données scientifiques."@fr .

:FAIRDataHandling rdf:type proj:DataManagement ;
    skos:prefLabel "FAIR Data Handling"@en , "Gestion des données FAIR"@fr ;
    rdfs:comment "Applying FAIR principles to ensure that research data is Findable, Accessible, Interoperable, and Reusable."@en ,
                 "Application des principes FAIR pour garantir des données trouvables, accessibles, interopérables et réutilisables."@fr .

:GuixPackaging rdf:type proj:Computational ;
    skos:prefLabel "Guix Packaging"@en , "Empaquetage Guix"@fr ;
    rdfs:comment "Creating and maintaining Guix packages to ensure reproducible software environments for scientific computing."@en ,
                 "Création et maintenance de paquets Guix pour assurer des environnements logiciels reproductibles."@fr .

:MLIP rdf:type proj:Computational ;
    skos:prefLabel "Machine Learning Interatomic Potentials"@en , "Potentiels interatomiques par apprentissage automatique"@fr ;
    rdfs:comment "Using and developing ML-based interatomic potentials for atomistic simulations, including training, validation, and workflow integration."@en ,
                 "Utilisation et développement de potentiels interatomiques basés sur le ML pour les simulations."@fr .

:MLPValidation rdf:type proj:Methodological ;
    skos:prefLabel "MLP Validation Methods"@en , "Méthodes de validation MLP"@fr ;
    rdfs:comment "Expertise in validation methods for machine learning potentials, including biased molecular dynamics, phonon-based sampling, and benchmark testing."@en ,
                 "Expertise dans les méthodes de validation pour les potentiels d'apprentissage automatique."@fr .

:MLWorkflowDesign rdf:type proj:Methodological ;
    skos:prefLabel "Machine Learning Workflow Design"@en , "Conception de flux de travail d'apprentissage automatique"@fr ;
    rdfs:comment "Designing ML workflows involving data preparation, feature engineering, training, validation, and deployment for scientific tasks."@en ,
                 "Conception de flux de travail ML incluant la préparation des données et le déploiement."@fr .

:NeuralNetworkPotentials rdf:type proj:Computational ;
    skos:prefLabel "Neural Network Potentials"@en , "Potentiels de réseaux de neurones"@fr ;
    rdfs:comment "Expertise in Behler-Parrinello neural network architectures and other neural network-based interatomic potentials for atomistic simulations."@en ,
                 "Expertise dans les architectures de réseaux de neurones pour potentiels interatomiques."@fr .

:WebDevelopment rdf:type proj:Methodological ;
    skos:prefLabel "Web Application Development"@en , "Développement d'applications web"@fr ;
    rdfs:comment "Design and implementation of user-facing web applications for presenting, accessing, or submitting scientific data and workflows."@en ,
                 "Conception et implémentation d'applications web pour l'accès aux données scientifiques."@fr .

:WorkflowOrchestration rdf:type proj:Methodological ;
    skos:prefLabel "Workflow Orchestration"@en , "Orchestration de flux de travail"@fr ;
    rdfs:comment "Coordinating and managing computational workflows using orchestration tools such as CWL, Nextflow, or Airflow."@en ,
                 "Coordination et gestion de flux de calculs via des outils comme CWL ou Nextflow."@fr .

:AiiDAPluginDevelopment rdf:type proj:Computational ;
    skos:prefLabel "AiiDA Plugin Development"@en , "Développement de plugins AiiDA"@fr ;
    rdfs:comment "Development of AiiDA plugins to interface scientific simulation codes with automated workflow engines."@en ,
                 "Développement de plugins AiiDA pour interfacer des codes de simulation avec des moteurs automatisés."@fr .

:AiidaWorkflows rdf:type proj:Computational ;
    skos:prefLabel "AiiDA Workflows"@en , "Flux de travail AiiDA"@fr ;
    rdfs:comment "Design and execution of automated and reproducible scientific workflows using the AiiDA computational framework."@en ,
                 "Conception de flux scientifiques automatisés via le framework AiiDA."@fr .

:LargeScaleWorkflows rdf:type proj:Computational ;
    skos:prefLabel "Large-scale Workflows"@en , "Flux de travail à grande échelle"@fr ;
    rdfs:comment "Design and execution of large-scale computational workflows running across distributed or HPC infrastructures."@en ,
                 "Conception et exécution de flux de travail de grande échelle sur des infrastructures distribuées."@fr .

:MetadataStandardization rdf:type proj:DataManagement ;
    skos:prefLabel "Metadata Standardization"@en , "Standardisation des métadonnées"@fr ;
    rdfs:comment "Defining, adopting, and applying metadata schemas to improve data interoperability and reusability."@en ,
                 "Définition et application de schémas de métadonnées pour améliorer l'interopérabilité."@fr .

:AIApproaches rdf:type proj:Methodological ;
    skos:prefLabel "AI Approaches"@en , "Approches IA"@fr ;
    rdfs:comment "General methodological approaches based on artificial intelligence for analysis, prediction, or automation in scientific research."@en ,
                 "Approches méthodologiques basées sur l'intelligence artificielle pour la recherche."@fr .

:MachineLearning rdf:type proj:Methodological ;
    skos:prefLabel "Machine Learning"@en , "Apprentissage automatique"@fr ;
    rdfs:comment "Methods and algorithms that build models based on sample data to make predictions or decisions."@en ,
                 "Méthodes et algorithmes construisant des modèles à partir de données d'apprentissage pour faire des prédictions ou des décisions."@fr .

:DeepLearning rdf:type proj:Methodological ;
    skos:prefLabel "Deep Learning"@en , "Apprentissage profond"@fr ;
    rdfs:comment "Machine learning methods based on artificial neural networks with representation learning."@en ,
                 "Méthodes d'apprentissage automatique basées sur des réseaux de neurones artificiels."@fr .

:ActiveLearning rdf:type proj:Methodological ;
    skos:prefLabel "Active Learning"@en , "Apprentissage actif"@fr ;
    rdfs:comment "An interactive machine learning approach that queries user or simulations to label new data points dynamically."@en ,
                 "Approche d'apprentissage automatique interactive interrogeant un utilisateur ou une simulation pour étiqueter de nouvelles données."@fr .

:BayesianOptimization rdf:type proj:Methodological ;
    skos:prefLabel "Bayesian Optimization"@en , "Optimisation bayésienne"@fr ;
    rdfs:comment "Sequential design strategy for global optimization of black-box functions, heavily used in materials discovery."@en ,
                 "Stratégie d'optimisation séquentielle pour des fonctions boîte noire, utilisée dans la découverte de matériaux."@fr .

:GenerativeModels rdf:type proj:Methodological ;
    skos:prefLabel "Generative Models"@en , "Modèles génératifs"@fr ;
    rdfs:comment "Generative AI approaches for predicting structural and molecular material designs."@en ,
                 "Approches d'IA générative pour prédire la structure et le design moléculaire de matériaux."@fr .

:ComputerVision rdf:type proj:Computational ;
    skos:prefLabel "Computer Vision & Image Analysis"@en , "Vision par ordinateur et analyse d'images"@fr ;
    rdfs:comment "Processing and analyzing digital images from characterization and microscopy techniques."@en ,
                 "Traitement et analyse d'images numériques obtenues par des techniques de caractérisation et de microscopie."@fr .

:NaturalLanguageProcessing rdf:type proj:Computational ;
    skos:prefLabel "Natural Language Processing"@en , "Traitement automatique du langage naturel"@fr ;
    rdfs:comment "Data mining of scientific literature and patents using natural language processing techniques."@en ,
                 "Fouille de données dans la littérature scientifique et les brevets à l'aide de techniques de TALN."@fr .

:DataEngineering rdf:type proj:DataManagement ;
    skos:prefLabel "Data Engineering"@en , "Ingénierie des données"@fr ;
    rdfs:comment "Building data pipelines, database systems, and infrastructure for FAIR data implementation."@en ,
                 "Conception de pipelines de données, de systèmes de bases de données et d'infrastructures FAIR."@fr .

:MachineLearningEngineering rdf:type proj:Computational ;
    skos:prefLabel "Machine Learning Engineering"@en , "Ingénierie de l'apprentissage automatique"@fr ;
    rdfs:comment "Designing, deploying, and optimizing operational ML models for scientific workloads."@en ,
                 "Conception, déploiement et optimisation de modèles d'apprentissage automatique opérationnels."@fr .

:ScientificSoftwareDevelopment rdf:type proj:Computational ;
    skos:prefLabel "Scientific Software Development"@en , "Développement de logiciels scientifiques"@fr ;
    rdfs:comment "Writing robust scientific software packages, APIs, or user interfaces."@en ,
                 "Développement de paquets logiciels scientifiques, d'APIs ou d'interfaces utilisateur."@fr .

:RobotProgrammingAndControl rdf:type proj:Computational ;
    skos:prefLabel "Robot Programming and Control"@en , "Programmation et contrôle de robots"@fr ;
    rdfs:comment "Programming robotic controllers and interfaces (e.g. ROS, PLC) for laboratory automation."@en ,
                 "Programmation de contrôleurs et d'interfaces robotiques pour l'automatisation de laboratoire."@fr .

:HardwareSoftwareIntegration rdf:type proj:Computational ;
    skos:prefLabel "Hardware-Software Integration"@en , "Intégration matériel-logiciel"@fr ;
    rdfs:comment "Interfacing physical laboratory instruments with computers using serial/API protocols."@en ,
                 "Interfaçage d'instruments de laboratoire avec des ordinateurs via des protocoles série/API."@fr .

:FluidicSystemDesign rdf:type proj:Methodological ;
    skos:prefLabel "Liquid Handling & Fluidic System Design"@en , "Gestion des liquides et conception aéraulique/fluidique"@fr ;
    rdfs:comment "Designing liquid handling workflows, microfluidics, and millifluidics devices."@en ,
                 "Conception de flux de travail pour la manipulation de liquides et dispositifs micro/millifluidiques."@fr .

:HighThroughputScreenDesign rdf:type proj:Methodological ;
    skos:prefLabel "High-Throughput Screen Design"@en , "Conception de criblage à haut débit"@fr ;
    rdfs:comment "Setting up combinatorial experimental workflows and library screening strategies."@en ,
                 "Mise en place de flux expérimentaux combinatoires et stratégies de criblage de photothèques/banques."@fr .

:CombinatorialSynthesis rdf:type proj:Methodological ;
    skos:prefLabel "Combinatorial Synthesis"@en , "Synthèse combinatoire"@fr ;
    rdfs:comment "Execution of combinatorial experiments for rapid exploration of compositional space."@en ,
                 "Exécution d'expériences combinatoires pour une exploration rapide des espaces de composition."@fr .

:SelfDrivingLab rdf:type proj:Methodological ;
    skos:prefLabel "Self-Driving Laboratory"@en , "Laboratoire autonome"@fr ;
    rdfs:comment "Autonomous laboratories operating under closed-loop AI and active learning orchestration."@en ,
                 "Laboratoires autonomes fonctionnant en boucle fermée pilotés par l'IA et l'apprentissage actif."@fr .

:SynchrotronBeamlineOperation rdf:type proj:Methodological ;
    skos:prefLabel "Synchrotron Beamline Operation"@en , "Exploitation de lignes de lumière synchrotron"@fr ;
    rdfs:comment "Operating beamlines for X-ray scattering and spectroscopy experiments (e.g. ESRF, SOLEIL)."@en ,
                 "Exploitation de lignes de lumière pour des expériences de diffusion de rayons X et de spectroscopie."@fr .

:AutomatedElectronMicroscopy rdf:type proj:Methodological ;
    skos:prefLabel "Automated Electron Microscopy"@en , "Microscopie électronique automatisée"@fr ;
    rdfs:comment "Automated mapping using Scanning and Transmission Electron Microscopy (SEM/TEM)."@en ,
                 "Cartographie automatisée par microscopie électronique à balayage et à transmission (MEB/MET)."@fr .

:MOF rdf:type proj:Keyword ;
    skos:prefLabel "Metal-Organic Frameworks"@en , "Réseaux métallo-organiques"@fr ;
    rdfs:comment "Expertise in the chemistry, structure, modelling, or application of metal-organic frameworks."@en ,
                 "Expertise dans la chimie, la structure et la modélisation des réseaux métallo-organiques."@fr .

:AdvancedAlloys rdf:type proj:Keyword ;
    skos:prefLabel "Advanced Alloys"@en , "Alliages avancés"@fr ;
    rdfs:comment "Advanced structural and functional metallic alloy systems."@en ,
                 "Systèmes d'alliages métalliques structurels et fonctionnels avancés."@fr .

:HighEntropyAlloys rdf:type proj:Keyword ;
    skos:prefLabel "High-Entropy Alloys"@en , "Alliages à haute entropie"@fr ;
    rdfs:comment "Multi-principal element alloys synthesized near equiatomic compositions."@en ,
                 "Alliages à plusieurs éléments principaux synthétisés dans des compositions quasi-équiatomiques."@fr .

:EnergyTransition rdf:type proj:Keyword ;
    skos:prefLabel "Energy Transition"@en , "Transition énergétique"@fr ;
    rdfs:comment "Materials research directly targeting clean energy harvesting, conversion, and storage."@en ,
                 "Recherche sur les matériaux visant la collecte, la conversion et le stockage d'énergie propre."@fr .

:Photovoltaics rdf:type proj:Keyword ;
    skos:prefLabel "Photovoltaics"@en , "Photovoltaïque"@fr ;
    rdfs:comment "Photovoltaic materials and next-generation solar energy devices."@en ,
                 "Matériaux photovoltaïques et dispositifs d'énergie solaire de nouvelle génération."@fr .

# =========================================================================
# New terms -  materials (proj:Keyword)
# =========================================================================
:2DMaterials rdf:type proj:Keyword ;
    skos:prefLabel "2D Materials"@en , "Matériaux 2D"@fr ;
    rdfs:comment "Materials with a single layer or few layers of atoms, such as graphene, boron nitride, or transition metal dichalcogenides."@en ,
                 "Matériaux composés d'une seule couche ou de quelques couches d'atomes, comme le graphène ou le nitrure de bore."@fr .

:3DMaterials rdf:type proj:Keyword ;
    skos:prefLabel "3D Materials"@en , "Matériaux 3D"@fr ;
    rdfs:comment "Materials structured in three dimensions, including bulk materials and 3D-printed structures."@en ,
                 "Matériaux structurés en trois dimensions, y compris les matériaux massifs et les structures imprimées en 3D."@fr .

:AdvancedCeramics rdf:type proj:Keyword ;
    skos:prefLabel "Advanced Ceramics"@en , "Céramiques avancées"@fr ;
    rdfs:comment "High-performance ceramic materials with tailored properties for structural, thermal, or electrical applications."@en ,
                 "Matériaux céramiques haute performance avec des propriétés adaptées pour des applications structurelles, thermiques ou électriques."@fr .

:Perovskites rdf:type proj:Keyword ;
    skos:prefLabel "Perovskites"@en , "Pérovskites"@fr ;
    rdfs:comment "Materials with the perovskite crystal structure, often used in photovoltaics, catalysis, and energy storage."@en ,
                 "Matériaux avec une structure cristalline pérovskite, souvent utilisés dans le photovoltaïque, la catalyse et le stockage d'énergie."@fr .

:HighEntropyCeramics rdf:type proj:Keyword ;
    skos:prefLabel "High-Entropy Ceramics"@en , "Céramiques à haute entropie"@fr ;
    rdfs:comment "Ceramic materials composed of multiple principal elements in near-equiatomic ratios, exhibiting unique properties."@en ,
                 "Matériaux céramiques composés de plusieurs éléments principaux dans des rapports quasi-équiatomiques, présentant des propriétés uniques."@fr .

:MetallicGlasses rdf:type proj:Keyword ;
    skos:prefLabel "Metallic Glasses"@en , "Verres métalliques"@fr ;
    rdfs:comment "Amorphous metallic alloys with high strength and unique mechanical properties."@en ,
                 "Alliages métalliques amorphes avec une haute résistance et des propriétés mécaniques uniques."@fr .

:NanostructuredMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Nanostructured Materials"@en , "Matériaux nanostructurés"@fr ;
    rdfs:comment "Materials with structural features at the nanoscale, exhibiting enhanced mechanical, optical, or electrical properties."@en ,
                 "Matériaux présentant des caractéristiques structurelles à l'échelle nanométrique, avec des propriétés mécaniques, optiques ou électriques améliorées."@fr .

:Composites rdf:type proj:Keyword ;
    skos:prefLabel "Composites"@en , "Composites"@fr ;
    rdfs:comment "Materials composed of two or more distinct phases, combining properties of their constituent materials."@en ,
                 "Matériaux composés de deux phases ou plus, combinant les propriétés de leurs matériaux constituants."@fr .

:Polymers rdf:type proj:Keyword ;
    skos:prefLabel "Polymers"@en , "Polymères"@fr ;
    rdfs:comment "Macromolecular materials with diverse applications, including plastics, elastomers, and fibers."@en ,
                 "Matériaux macromoléculaires avec des applications variées, y compris les plastiques, les élastomères et les fibres."@fr .

:Biomaterials rdf:type proj:Keyword ;
    skos:prefLabel "Biomaterials"@en , "Biomatériaux"@fr ;
    rdfs:comment "Materials designed to interact with biological systems for medical or biomedical applications."@en ,
                 "Matériaux conçus pour interagir avec les systèmes biologiques pour des applications médicales ou biomédicales."@fr .

# =========================================================================
# New term - Computational method (proj:Computational)
# =========================================================================
:AbInitioCalculations rdf:type proj:Computational ;
    skos:prefLabel "Ab Initio Calculations"@en , "Calculs ab initio"@fr ;
    rdfs:comment "First-principles computational methods based on quantum mechanics to predict material properties."@en ,
                 "Méthodes de calcul basées sur la mécanique quantique pour prédire les propriétés des matériaux."@fr .

:DFT rdf:type proj:Computational ;
    skos:prefLabel "Density Functional Theory"@en , "Théorie de la fonctionnelle de la densité"@fr ;
    rdfs:comment "Computational quantum mechanical modeling method to investigate the electronic structure of materials."@en ,
                 "Méthode de modélisation quantique pour étudier la structure électronique des matériaux."@fr .

:MolecularDynamics rdf:type proj:Computational ;
    skos:prefLabel "Molecular Dynamics"@en , "Dynamique moléculaire"@fr ;
    rdfs:comment "Computer simulation method for studying the physical movements of atoms and molecules."@en ,
                 "Méthode de simulation informatique pour étudier les mouvements physiques des atomes et des molécules."@fr .

:FiniteElementModeling rdf:type proj:Computational ;
    skos:prefLabel "Finite Element Modeling"@en , "Modélisation par éléments finis"@fr ;
    rdfs:comment "Numerical method for solving partial differential equations to model complex structures and materials."@en ,
                 "Méthode numérique pour résoudre des équations différentielles partielles et modéliser des structures complexes."@fr .

:MultiScaleModeling rdf:type proj:Computational ;
    skos:prefLabel "Multi-Scale Modeling"@en , "Modélisation multi-échelle"@fr ;
    rdfs:comment "Computational approach that links atomic-scale simulations to macroscopic material behavior."@en ,
                 "Approche computationnelle qui relie les simulations à l'échelle atomique au comportement macroscopique des matériaux."@fr .

:MonteCarloSimulations rdf:type proj:Computational ;
    skos:prefLabel "Monte Carlo Simulations"@en , "Simulations Monte Carlo"@fr ;
    rdfs:comment "Computational method using random sampling for statistical analysis of material properties and behaviors."@en ,
                 "Méthode computationnelle utilisant un échantillonnage aléatoire pour l'analyse statistique des propriétés et comportements des matériaux."@fr .

:CALPHAD rdf:type proj:Computational ;
    skos:prefLabel "CALPHAD"@en , "CALPHAD"@fr ;
    rdfs:comment "Computational thermodynamics method for phase diagram calculations and material property predictions."@en ,
                 "Méthode de thermodynamique computationnelle pour les calculs de diagrammes de phase et les prédictions de propriétés des matériaux."@fr .

# =========================================================================
# New termns - characterization (proj:Methodological)
# =========================================================================
:XRayDiffraction rdf:type proj:Methodological ;
    skos:prefLabel "X-ray Diffraction"@en , "Diffraction des rayons X"@fr ;
    rdfs:comment "Technique for determining the atomic or molecular structure of a crystal."@en ,
                 "Technique permettant de déterminer la structure atomique ou moléculaire d'un cristal."@fr .

:ElectronMicroscopy rdf:type proj:Methodological ;
    skos:prefLabel "Electron Microscopy"@en , "Microscopie électronique"@fr ;
    rdfs:comment "High-resolution imaging technique using electrons to visualize material structures at the nanoscale."@en ,
                 "Technique d'imagerie à haute résolution utilisant des électrons pour visualiser les structures matérielles à l'échelle nanométrique."@fr .

:Spectroscopy rdf:type proj:Methodological ;
    skos:prefLabel "Spectroscopy"@en , "Spectroscopie"@fr ;
    rdfs:comment "Analytical technique for studying the interaction of materials with electromagnetic radiation."@en ,
                 "Technique analytique pour étudier l'interaction des matériaux avec le rayonnement électromagnétique."@fr .

:Tomography rdf:type proj:Methodological ;
    skos:prefLabel "Tomography"@en , "Tomographie"@fr ;
    rdfs:comment "Imaging technique for creating 3D representations of internal structures of materials."@en ,
                 "Technique d'imagerie pour créer des représentations 3D des structures internes des matériaux."@fr .

:ThermalAnalysis rdf:type proj:Methodological ;
    skos:prefLabel "Thermal Analysis"@en , "Analyse thermique"@fr ;
    rdfs:comment "Techniques for measuring thermal properties of materials, such as thermal conductivity and heat capacity."@en ,
                 "Techniques de mesure des propriétés thermiques des matériaux, comme la conductivité thermique et la capacité thermique."@fr .

:MechanicalTesting rdf:type proj:Methodological ;
    skos:prefLabel "Mechanical Testing"@en , "Essais mécaniques"@fr ;
    rdfs:comment "Experimental methods for evaluating mechanical properties of materials, such as strength, hardness, and ductility."@en ,
                 "Méthodes expérimentales pour évaluer les propriétés mécaniques des matériaux, comme la résistance, la dureté et la ductilité."@fr .

# =========================================================================
# New terms - Processes (proj:Methodological)
# =========================================================================
:AdditiveManufacturing rdf:type proj:Methodological ;
    skos:prefLabel "Additive Manufacturing"@en , "Fabrication additive"@fr ;
    rdfs:comment "Process of creating three-dimensional objects by adding material layer by layer."@en ,
                 "Processus de création d'objets tridimensionnels en ajoutant du matériau couche par couche."@fr .

:LaserRemelting rdf:type proj:Methodological ;
    skos:prefLabel "Laser Remelting"@en , "Refusion laser"@fr ;
    rdfs:comment "Technique using laser energy to melt and solidify materials for improved properties."@en ,
                 "Technique utilisant l'énergie laser pour fondre et solidifier des matériaux afin d'améliorer leurs propriétés."@fr .

:ColdSpray rdf:type proj:Methodological ;
    skos:prefLabel "Cold Spray"@en , "Projection à froid"@fr ;
    rdfs:comment "Coating process where powder particles are accelerated to high velocities and deposited on a substrate."@en ,
                 "Procédé de revêtement où des particules de poudre sont accélérées à haute vitesse et déposées sur un substrat."@fr .

:ThermalSpray rdf:type proj:Methodological ;
    skos:prefLabel "Thermal Spray"@en , "Projection thermique"@fr ;
    rdfs:comment "Process where melted or heated materials are sprayed onto a surface to form a coating."@en ,
                 "Procédé où des matériaux fondus ou chauffés sont pulvérisés sur une surface pour former un revêtement."@fr .

:CombinatorialSynthesis rdf:type proj:Methodological ;
    skos:prefLabel "Combinatorial Synthesis"@en , "Synthèse combinatoire"@fr ;
    rdfs:comment "Execution of combinatorial experiments for rapid exploration of compositional space."@en ,
                 "Exécution d'expériences combinatoires pour une exploration rapide des espaces de composition."@fr .

:HighThroughputSynthesis rdf:type proj:Methodological ;
    skos:prefLabel "High-Throughput Synthesis"@en , "Synthèse à haut débit"@fr ;
    rdfs:comment "Automated and parallelized synthesis methods for rapid production and screening of materials."@en ,
                 "Méthodes de synthèse automatisées et parallélisées pour une production et un criblage rapides des matériaux."@fr .

# =========================================================================
# New terms - Applications (proj:Keyword)
# =========================================================================
:EnergyStorage rdf:type proj:Keyword ;
    skos:prefLabel "Energy Storage"@en , "Stockage d'énergie"@fr ;
    rdfs:comment "Technologies and materials for storing energy, including batteries, thermal storage, and hydrogen storage."@en ,
                 "Technologies et matériaux pour stocker l'énergie, y compris les batteries, le stockage thermique et l'hydrogène."@fr .

:HydrogenProduction rdf:type proj:Keyword ;
    skos:prefLabel "Hydrogen Production"@en , "Production d'hydrogène"@fr ;
    rdfs:comment "Materials and processes for producing hydrogen, including electrolysis, thermochemical, and biological methods."@en ,
                 "Matériaux et procédés pour produire de l'hydrogène, y compris l'électrolyse, les méthodes thermochimiques et biologiques."@fr .

:Catalysis rdf:type proj:Keyword ;
    skos:prefLabel "Catalysis"@en , "Catalyse"@fr ;
    rdfs:comment "Processes and materials that accelerate chemical reactions without being consumed."@en ,
                 "Processus et matériaux qui accélèrent les réactions chimiques sans être consommés."@fr .

:Electrocatalysis rdf:type proj:Keyword ;
    skos:prefLabel "Electrocatalysis"@en , "Électrocatalyse"@fr ;
    rdfs:comment "Catalytic processes driven by electrical energy, often used in energy conversion and storage."@en ,
                 "Processus catalytiques pilotés par l'énergie électrique, souvent utilisés dans la conversion et le stockage d'énergie."@fr .

:Sensors rdf:type proj:Keyword ;
    skos:prefLabel "Sensors"@en , "Capteurs"@fr ;
    rdfs:comment "Devices and materials for detecting and measuring physical, chemical, or biological quantities."@en ,
                 "Dispositifs et matériaux pour détecter et mesurer des quantités physiques, chimiques ou biologiques."@fr .

:RenewableEnergy rdf:type proj:Keyword ;
    skos:prefLabel "Renewable Energy"@en , "Énergie renouvelable"@fr ;
    rdfs:comment "Materials and technologies for harnessing energy from renewable sources such as solar, wind, and biomass."@en ,
                 "Matériaux et technologies pour capter l'énergie à partir de sources renouvelables comme le solaire, l'éolien et la biomasse."@fr .

:Spintronics rdf:type proj:Keyword ;
    skos:prefLabel "Spintronics"@en , "Spintronique"@fr ;
    rdfs:comment "Materials and devices that exploit the spin of electrons for information storage and processing."@en ,
                 "Matériaux et dispositifs qui exploitent le spin des électrons pour le stockage et le traitement de l'information."@fr .

:PhotonicMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Photonic Materials"@en , "Matériaux photoniques"@fr ;
    rdfs:comment "Materials designed to manipulate light for applications in optics, telecommunications, and energy."@en ,
                 "Matériaux conçus pour manipuler la lumière pour des applications en optique, télécommunications et énergie."@fr .

# =========================================================================
# New terms - synthesis(proj:Methodological)
# =========================================================================
:ThinFilmDeposition rdf:type proj:Methodological ;
    skos:prefLabel "Thin Film Deposition"@en , "Dépôt de couches minces"@fr ;
    rdfs:comment "Techniques for depositing thin layers of material onto a substrate, such as PVD, CVD, or ALD."@en ,
                 "Techniques pour déposer des couches minces de matériau sur un substrat, comme PVD, CVD ou ALD."@fr .

:MolecularBeamEpitaxy rdf:type proj:Methodological ;
    skos:prefLabel "Molecular Beam Epitaxy"@en , "Épitaxie par faisceau moléculaire"@fr ;
    rdfs:comment "Technique for growing high-quality crystalline thin films by depositing atomic or molecular beams onto a substrate."@en ,
                 "Technique pour faire croître des couches minces cristallines de haute qualité en déposant des faisceaux atomiques ou moléculaires sur un substrat."@fr .

:ChemicalVaporDeposition rdf:type proj:Methodological ;
    skos:prefLabel "Chemical Vapor Deposition"@en , "Dépôt chimique en phase vapeur"@fr ;
    rdfs:comment "Process where chemical precursors react on a substrate surface to form a solid thin film."@en ,
                 "Procédé où des précurseurs chimiques réagissent sur une surface de substrat pour former une couche mince solide."@fr .

:PhysicalVaporDeposition rdf:type proj:Methodological ;
    skos:prefLabel "Physical Vapor Deposition"@en , "Dépôt physique en phase vapeur"@fr ;
    rdfs:comment "Process where material is vaporized and deposited onto a substrate to form a thin film."@en ,
                 "Procédé où le matériau est vaporisé et déposé sur un substrat pour former une couche mince."@fr .

# =========================================================================
# New terms - optimization and design (proj:Methodological)
# =========================================================================
:MultiObjectiveOptimization rdf:type proj:Methodological ;
    skos:prefLabel "Multi-Objective Optimization"@en , "Optimisation multi-objectifs"@fr ;
    rdfs:comment "Optimization methods that balance multiple conflicting objectives in material and process design."@en ,
                 "Méthodes d'optimisation qui équilibrent plusieurs objectifs conflictuels dans la conception de matériaux et de procédés."@fr .

:QualityDiversity rdf:type proj:Methodological ;
    skos:prefLabel "Quality Diversity"@en , "Diversité de qualité"@fr ;
    rdfs:comment "Approach for generating a diverse set of high-performing solutions in material design and optimization."@en ,
                 "Approche pour générer un ensemble diversifié de solutions performantes dans la conception et l'optimisation de matériaux."@fr .

:InverseDesign rdf:type proj:Methodological ;
    skos:prefLabel "Inverse Design"@en , "Conception inverse"@fr ;
    rdfs:comment "Design approach that starts with desired properties and works backward to identify materials or structures that meet those properties."@en ,
                 "Approche de conception qui part des propriétés souhaitées pour identifier les matériaux ou structures qui les satisfont."@fr .

# =========================================================================
# New terms - Data Analysis (proj:DataManagement)
# =========================================================================
:BigDataAnalysis rdf:type proj:DataManagement ;
    skos:prefLabel "Big Data Analysis"@en , "Analyse de grandes données"@fr ;
    rdfs:comment "Techniques and tools for processing and analyzing large and complex datasets in materials science."@en ,
                 "Techniques et outils pour traiter et analyser de grands ensembles de données complexes en science des matériaux."@fr .

:DataMining rdf:type proj:DataManagement ;
    skos:prefLabel "Data Mining"@en , "Fouille de données"@fr ;
    rdfs:comment "Process of discovering patterns and knowledge from large datasets using computational techniques."@en ,
                 "Processus de découverte de motifs et de connaissances à partir de grands ensembles de données à l'aide de techniques computationnelles."@fr .

:DatabaseMining rdf:type proj:DataManagement ;
    skos:prefLabel "Database Mining"@en , "Exploration de bases de données"@fr ;
    rdfs:comment "Extracting useful information from scientific databases for materials discovery and analysis."@en ,
                 "Extraction d'informations utiles à partir de bases de données scientifiques pour la découverte et l'analyse de matériaux."@fr .


#-----------------------------------------------------------------------------------------------
:Metallurgy rdf:type proj:Keyword ;
    skos:prefLabel "Metallurgy"@en, "Métallurgie"@fr ;
    rdfs:comment "Study and application of metal extraction, processing, and alloy design."@en,
                 "Étude et application de l'extraction, du traitement des métaux et de la conception d'alliages."@fr .

:HighSpeedMetallurgy rdf:type proj:Keyword ;
    skos:prefLabel "High-Speed Metallurgy"@en, "Métallurgie haut-débit"@fr ;
    rdfs:comment "Rapid synthesis and processing of metallic materials using high-throughput methods."@en,
                 "Synthèse et traitement rapide des matériaux métalliques à l'aide de méthodes à haut débit."@fr .

:CombinatorialMetallurgy rdf:type proj:Keyword ;
    skos:prefLabel "Combinatorial Metallurgy"@en, "Métallurgie combinatoire"@fr ;
    rdfs:comment "Use of combinatorial approaches to explore alloy compositions and properties."@en,
                 "Utilisation d'approches combinatoires pour explorer les compositions et propriétés des alliages."@fr .

:Corrosion rdf:type proj:Keyword ;
    skos:prefLabel "Corrosion"@en, "Corrosion"@fr ;
    rdfs:comment "Study of the degradation of materials due to chemical or electrochemical reactions with their environment."@en,
                 "Étude de la dégradation des matériaux due aux réactions chimiques ou électrochimiques avec leur environnement."@fr .

:SurfaceEngineering rdf:type proj:Keyword ;
    skos:prefLabel "Surface Engineering"@en, "Ingénierie des surfaces"@fr ;
    rdfs:comment "Modification of the surface properties of materials to improve performance."@en,
                 "Modification des propriétés de surface des matériaux pour améliorer leurs performances."@fr .

:SurfaceScience rdf:type proj:Keyword ;
    skos:prefLabel "Surface Science"@en, "Science des surfaces"@fr ;
    rdfs:comment "Study of the physical and chemical properties of surfaces and interfaces."@en,
                 "Étude des propriétés physiques et chimiques des surfaces et interfaces."@fr .

:NuclearMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Nuclear Materials"@en, "Matériaux nucléaires"@fr ;
    rdfs:comment "Materials used in nuclear energy applications, including fuels and structural components."@en,
                 "Matériaux utilisés dans les applications d'énergie nucléaire, y compris les combustibles et les composants structurels."@fr .

:PhaseTransformations rdf:type proj:Keyword ;
    skos:prefLabel "Phase Transformations"@en, "Transformations de phase"@fr ;
    rdfs:comment "Study of changes in the structure of materials, such as solid-state phase transitions."@en,
                 "Étude des changements de structure des matériaux, comme les transitions de phase à l'état solide."@fr .

:Thermodynamics rdf:type proj:Keyword ;
    skos:prefLabel "Thermodynamics"@en, "Thermodynamique"@fr ;
    rdfs:comment "Study of heat, work, temperature, and their relation to energy and entropy in materials."@en,
                 "Étude de la chaleur, du travail, de la température et de leur relation avec l'énergie et l'entropie dans les matériaux."@fr .

:ThermalProperties rdf:type proj:Keyword ;
    skos:prefLabel "Thermal Properties"@en, "Propriétés thermiques"@fr ;
    rdfs:comment "Study of how materials respond to changes in temperature, including conductivity and expansion."@en,
                 "Étude de la réponse des matériaux aux changements de température, y compris la conductivité et la dilatation."@fr .

:MechanicalProperties rdf:type proj:Keyword ;
    skos:prefLabel "Mechanical Properties"@en, "Propriétés mécaniques"@fr ;
    rdfs:comment "Study of how materials deform or break under applied forces."@en,
                 "Étude de la manière dont les matériaux se déforment ou se brisent sous des forces appliquées."@fr .

:Microstructure rdf:type proj:Keyword ;
    skos:prefLabel "Microstructure"@en, "Microstructure"@fr ;
    rdfs:comment "Study of the fine structure of materials at the microscopic or nanoscopic scale."@en,
                 "Étude de la structure fine des matériaux à l'échelle microscopique ou nanoscopique."@fr .

:ArchitecturedMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Architectured Materials"@en, "Matériaux architecturés"@fr ;
    rdfs:comment "Materials designed with controlled architectures to achieve specific properties."@en,
                 "Matériaux conçus avec des architectures contrôlées pour obtenir des propriétés spécifiques."@fr .

:FunctionalMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Functional Materials"@en, "Matériaux fonctionnels"@fr ;
    rdfs:comment "Materials with specific functions, such as electrical, magnetic, or optical properties."@en,
                 "Matériaux dotés de fonctions spécifiques, comme des propriétés électriques, magnétiques ou optiques."@fr .

:OpticalMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Optical Materials"@en, "Matériaux optiques"@fr ;
    rdfs:comment "Materials designed to manipulate light, such as lenses, mirrors, or photonic structures."@en,
                 "Matériaux conçus pour manipuler la lumière, comme des lentilles, des miroirs ou des structures photoniques."@fr .

:MagneticMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Magnetic Materials"@en, "Matériaux magnétiques"@fr ;
    rdfs:comment "Materials that exhibit magnetic properties, such as ferromagnetic or paramagnetic behavior."@en,
                 "Matériaux présentant des propriétés magnétiques, comme un comportement ferromagnétique ou paramagnétique."@fr .

:FerroelectricMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Ferroelectric Materials"@en, "Matériaux ferroélectriques"@fr ;
    rdfs:comment "Materials that exhibit spontaneous electric polarization reversible by an electric field."@en,
                 "Matériaux présentant une polarisation électrique spontanée réversible par un champ électrique."@fr .

:Piezomaterials rdf:type proj:Keyword ;
    skos:prefLabel "Piezoelectric Materials"@en, "Matériaux piézoélectriques"@fr ;
    rdfs:comment "Materials that generate an electric charge when mechanical stress is applied."@en,
                 "Matériaux qui génèrent une charge électrique lorsqu'une contrainte mécanique est appliquée."@fr .

:Nanomaterials rdf:type proj:Keyword ;
    skos:prefLabel "Nanomaterials"@en, "Nanomatériaux"@fr ;
    rdfs:comment "Materials with structural components smaller than 100 nanometers."@en,
                 "Matériaux dont les composants structurels sont inférieurs à 100 nanomètres."@fr .

:BoronNitride rdf:type proj:Keyword ;
    skos:prefLabel "Boron Nitride"@en, "Nitrure de bore"@fr ;
    rdfs:comment "Chemical compound with high thermal and chemical stability, used in high-performance applications."@en,
                 "Composé chimique doté d'une grande stabilité thermique et chimique, utilisé dans des applications haute performance."@fr .

:CarbonMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Carbon Materials"@en, "Matériaux carbonés"@fr ;
    rdfs:comment "Materials primarily composed of carbon, such as graphite, graphene, or carbon nanotubes."@en,
                 "Matériaux principalement composés de carbone, comme le graphite, le graphène ou les nanotubes de carbone."@fr .

:GlassMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Glass Materials"@en, "Matériaux vitreux"@fr ;
    rdfs:comment "Amorphous materials typically made from silica, used in optical and structural applications."@en,
                 "Matériaux amorphes généralement fabriqués à partir de silice, utilisés dans des applications optiques et structurelles."@fr .

:HybridMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Hybrid Materials"@en, "Matériaux hybrides"@fr ;
    rdfs:comment "Materials composed of two or more distinct phases, such as organic-inorganic hybrids."@en,
                 "Matériaux composés de deux phases distinctes ou plus, comme les hybrides organiques-inorganiques."@fr .

:InorganicMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Inorganic Materials"@en, "Matériaux inorganiques"@fr ;
    rdfs:comment "Materials that do not contain carbon-hydrogen bonds, such as metals, ceramics, and semiconductors."@en,
                 "Matériaux qui ne contiennent pas de liaisons carbone-hydrogène, comme les métaux, les céramiques et les semi-conducteurs."@fr .

:PhaseChangeMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Phase Change Materials"@en, "Matériaux à changement de phase"@fr ;
    rdfs:comment "Materials that change phase (e.g., solid to liquid) in response to temperature or other stimuli."@en,
                 "Matériaux qui changent de phase (par exemple, solide à liquide) en réponse à la température ou à d'autres stimuli."@fr .

:SemiconductorMaterials rdf:type proj:Keyword ;
    skos:prefLabel "Semiconductor Materials"@en, "Matériaux semi-conducteurs"@fr ;
    rdfs:comment "Materials with electrical conductivity between that of conductors and insulators, used in electronics."@en,
                 "Matériaux dont la conductivité électrique se situe entre celle des conducteurs et des isolants, utilisés en électronique."@fr .