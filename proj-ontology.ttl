@prefix proj:    <https://cnherrera.github.io/DIADEM-ontology/proj-ontology.ttl#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix vcard:   <http://www.w3.org/2006/vcard/ns#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix schema:  <http://schema.org/> .
@prefix prov:    <http://https://www.w3.org/TR/prov-o/> .

# ─────────────────────────────────────────────
#  Ontology declaration
# ─────────────────────────────────────────────

<https://cnherrera.github.io/DIADEM-ontology/proj-ontology.ttl>  rdf:type owl:Ontology ;
    dcterms:title        "PEPR Programme Ontology"@en ,
                         "Ontologie des Programmes PEPR"@fr ;
    dcterms:description  "Ontology supporting structured representation of French PEPR programs, its targeted and AAP projects, platforms, competences, tools, deliverables and human participation. Designed to enhance collaboration discovery, capability mapping and interoperability with external systems."@en ;
    dcterms:created      "2026-03-31"^^xsd:date ;
    owl:versionInfo      "1.0.0" ;
    rdfs:comment         "Base prefix: proj — -> to be changed "@en .


# ─────────────────────────────────────────────
#  Core Classes
# ─────────────────────────────────────────────

# -- Top-level Program --------------------------------------------------

proj:Program rdf:type owl:Class ;
    rdfs:subClassOf schema:ResearchProject ;
    skos:prefLabel "Program"@en , "Programme"@fr ;
    rdfs:label "Program"@en , "Programme"@fr ;
    rdfs:comment "A structured research initiative composed of multiple targeted projects and shared platforms. It defines strategic objectives, a funding framework, governance, and a long-term vision."@en ,
                 "Une initiative de recherche structurée, composée de plusieurs projets ciblés et de plateformes partagées. Elle définit des objectifs stratégiques, un cadre de financement, une gouvernance et une vision à long terme."@fr .


proj:Platform rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    skos:prefLabel "Platform"@en , "Plateforme"@fr ;
    rdfs:label "Platform"@en , "Plateforme"@fr ;
    rdfs:comment "A shared scientific and/or technical infrastructure that provides research teams with advanced resources such as computing capabilities, software tools, and data environments. It enables the development, execution, and sharing of methods, techniques, and/or scientific code under reproducible conditions, ensuring portability and consistency across different systems."@en ,
                 "Une infrastructure scientifique et/ou technique mutualisée qui met à disposition des équipes de recherche des ressources avancées telles que des capacités de calcul, des outils logiciels et des environnements de données. Elle permet de développer, exécuter et partager des méthodes, des techniques et/ou des codes scientifiques dans des conditions reproductibles, afin de garantir la portabilité et la cohérence des environnements sur différents systèmes."@fr .


proj:InfrastructurePlatform rdf:type owl:Class ;
    rdfs:subClassOf proj:Platform ;
    skos:prefLabel "Infrastructure Platform"@en , "Plateforme d'infrastructure"@fr ;
    rdfs:comment "A platform primarily focused on providing shared infrastructure capabilities such as data storage, experimental facilities, computing resources, or integration frameworks."@en ,
                 "Une plateforme principalement dédiée à la fourniture de capacités d'infrastructure mutualisées, telles que le stockage des données, les installations expérimentales, les ressources de calcul ou les cadres d'intégration."@fr .


proj:CharacterizationPlatform rdf:type owl:Class ;
    rdfs:subClassOf proj:Platform ;
    skos:prefLabel "Characterization Platform"@en , "Plateforme de caractérisation"@fr ;
    rdfs:comment "A platform dedicated to characterization activities, including chemical, structural, microscopic, optical, magnetic, electrical, and mechanical analyses. It may also support in situ or operando characterization, sensor development, and high-throughput data acquisition, especially under extreme conditions."@en ,
                 "Une plateforme dédiée aux activités de caractérisation, incluant des analyses chimiques, structurales, microscopiques, optiques, magnétiques, électriques et mécaniques. Elle peut également soutenir la caractérisation in situ ou operando, le développement de capteurs et l’acquisition de données à haut débit, en particulier en conditions extrêmes."@fr .


proj:SynthesisPlatform rdf:type owl:Class ;
    rdfs:subClassOf proj:Platform ;
    skos:prefLabel "Synthesis Platform"@en , "Plateforme de synthèse"@fr ;
    rdfs:comment "A platform dedicated to synthesis activities, including material preparation, process development, and the production of samples or compounds for research purposes."@en ,
                 "Une plateforme dédiée aux activités de synthèse, incluant la préparation de matériaux, le développement de procédés et la production d’échantillons ou de composés à des fins de recherche."@fr .


#proj:PlatformType rdf:type owl:Class ;
#    rdfs:comment "A controlled category used to classify platforms."@en ,
#                 "Une catégorie contrôlée utilisée pour classer les plateformes."@fr ;
#    skos:prefLabel "Platform Type"@en , "Type de plateforme"@fr .


proj:MaterialType rdf:type owl:Class ;
    rdfs:comment "A controlled category describing the material domain associated with a platform."@en ,
                 "Une catégorie contrôlée décrivant le domaine de matériaux associé à une plateforme."@fr ;
    skos:prefLabel "Material Type"@en , "Type de matériau"@fr .


proj:Dimension rdf:type owl:Class ;
    rdfs:comment "A controlled category describing the dimensionality associated with a material system or technique."@en ,
                 "Une catégorie contrôlée décrivant la dimensionalité associée à un système de matériaux ou technique."@fr ;
    skos:prefLabel "Dimension Type"@en , "Type de dimension"@fr .


proj:TechniqueType rdf:type owl:Class ;
    rdfs:comment "A controlled category describing a characterization technique."@en ,
                 "Une catégorie contrôlée décrivant une technique de caractérisation."@fr ;
    skos:prefLabel "Technique Type"@en , "Type de technique"@fr .


# -- Funding --------------------------------------------------------------

proj:Funding rdf:type owl:Class ;
    rdfs:label   "Funding"@en , "Financement"@fr ;
    rdfs:comment "A funding source or grant associated with a programme or project."@en .


# -- Projects (abstract base) ---------------------------------------------

proj:Project rdf:type owl:Class ;
    rdfs:label   "Project"@en , "Projet"@fr ;
    rdfs:comment "Abstract class for any project within the programme."@en .

proj:TargetedProject rdf:type owl:Class ;
    rdfs:subClassOf proj:Project ;
    rdfs:label   "Targeted Project"@en , "Projet Ciblé"@fr ;
    rdfs:comment "A project directly commissioned by the programme (projet ciblé)."@en .

proj:AAPProject rdf:type owl:Class ;
    rdfs:subClassOf proj:Project ;
    rdfs:label   "AAP Project"@en , "Projet AAP"@fr ;
    rdfs:comment "A project funded via an Appel à Projets (AAP)."@en .

# -- Organizations & People -----------------------------------------------

proj:Organization rdf:type owl:Class ;
    rdfs:label "Organization"@en , "Organisation"@fr ;
    rdfs:comment "A legal or academic entity involved in a program, such as a laboratory, university, research institute, company or infrastructure."@en .

proj:ResearchOrganization rdf:type owl:Class ;
    rdfs:subClassOf proj:Organization ;
    rdfs:label "Research organization"@en ;
    rdfs:comment "An organization performing research activities."@en .

proj:ResearchPerson rdf:type owl:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:label   "Person"@en , "Personne"@fr ;
    rdfs:comment "A natural person involved in the program and/or project."@en .

### no needed???
proj:Membership rdf:type owl:Class ;
    rdfs:label   "Membership"@en , "Affiliation"@fr ;
    rdfs:comment "Reification of a person's affiliation to an organisation with an optional role."@en .

# -- Work Packages --------------------------------------------------------

proj:WorkPackage rdf:type owl:Class ;
    rdfs:label   "Work Package"@en , "Lot de Travail"@fr ;
    rdfs:comment "A subdivision of a project."@en .

# -- Deliverables & Tasks -------------------------------------------------

proj:Deliverable rdf:type owl:Class ;
    rdfs:label   "Deliverable"@en , "Livrable"@fr ;
    rdfs:comment "A concrete output committed to in a work package."@en .

proj:Task rdf:type owl:Class ;
    rdfs:label   "Task"@en , "Tâche"@fr ;
    rdfs:comment "An atomic unit of work within a work package."@en .

# #############################################################3
# Parent classes Resource and ProjectOutput
###############################################################
proj:Resource rdf:type owl:Class ;
    rdfs:label "Resource"@en ,
               "Ressource"@fr ;
    rdfs:comment "Any resource used during the execution of a project."@en .

proj:ProjectOutput rdf:type owl:Class ;
    rdfs:label "Project Output"@en ,
               "Résultat du projet"@fr ;
    rdfs:comment "A scientific, technical or technological result generated by a project."@en .

# -->> Resources <<-----------------------------------------------------

proj:Equipment rdf:type owl:Class ;
    rdfs:subClassOf proj:Resource ;
    rdfs:label "Equipment"@en ,
               "Équipement"@fr ;
    rdfs:comment "A scientific instrument or experimental equipment."@en .

proj:Workflow rdf:type owl:Class ;
    rdfs:subClassOf proj:Resource ;
    rdfs:label "Workflow"@en ,
               "Workflow"@fr ;
    rdfs:comment "A computational or experimental workflow."@en .

proj:Protocol rdf:type owl:Class ;
    rdfs:subClassOf proj:Resource ;
    rdfs:label "Protocol"@en ,
               "Protocole"@fr ;
    rdfs:comment "An experimental or computational protocol."@en .

proj:Material rdf:type owl:Class ;
    rdfs:subClassOf proj:Resource ;
    rdfs:label "Material"@en ,
               "Matériau"@fr ;
    rdfs:comment "A material used during experiments or demonstrations."@en .

## -->> Scientific Outputs <<--------------------------------
proj:Publication rdf:type owl:Class ;
    rdfs:subClassOf proj:ProjectOutput ;
    rdfs:label "Publication"@en ,
               "Publication"@fr .

proj:Patent rdf:type owl:Class ;
    rdfs:subClassOf proj:ProjectOutput ;
    rdfs:label "Patent"@en ,
               "Brevet"@fr .

proj:Prototype rdf:type owl:Class ;
    rdfs:subClassOf proj:ProjectOutput ;
    rdfs:label "Prototype"@en ,
               "Prototype"@fr .

proj:Model rdf:type owl:Class ;
    rdfs:subClassOf proj:ProjectOutput ;
    rdfs:label "Model"@en ,
               "Modèle"@fr .

proj:DatabaseInfrastructure rdf:type owl:Class ;
    rdfs:subClassOf proj:SoftwareSystem , proj:ProjectOutput ;
    rdfs:label "Database infrastructure"@en ,
               "Infrastructure de bases de données"@fr ;
    rdfs:comment """A server environment, DBMS cluster (such as a MongoDB cluster), or hosting platform deployed online to serve multiple database instances. It acts as the execution and storage container managed by a primary host project."""@en ,
                 """Un environnement serveur, un cluster SGBD (tel qu'un cluster MongoDB) ou une plateforme d'hébergement déployée en ligne pour servir plusieurs instances de bases de données. Il agit comme le conteneur d'exécution et de stockage géré par un projet hôte principal."""@fr ;
    rdfs:isDefinedBy <http://example.org/proj#> .

proj:Database rdf:type owl:Class ;
    rdfs:subClassOf proj:ProjectOutput ;
    rdfs:label "Database"@en , "Base de données"@fr ;
    rdfs:comment """
    A structured collection of data (e.g., a specific MongoDB database) hosted on a 
    DatabaseInfrastructure. It represents a functional dataset output created through 
    collaborative efforts, populated with domain data supplied by a partner project and 
    instantiated online by the host project."""@en ,
    """Une collection structurée de données (par exemple, une base de données MongoDB 
    spécifique) hébergée sur une DatabaseInfrastructure. Elle représente un livrable de 
    données fonctionnel créé par des efforts de collaboration, alimenté par des données 
    metier fournies par un projet partenaire et instancié en ligne par le projet hôte."""@fr ;
    rdfs:isDefinedBy <http://example.org/proj#> .


proj:Webpage rdf:type owl:Class ;
    rdfs:label "Webpage" ;
    rdfs:comment "A webpage created as a product" ;
    rdfs:subClassOf proj:ProjectOutput .

proj:Benchmark rdf:type owl:Class ;
    rdfs:subClassOf proj:ProjectOutput ;
    rdfs:label "Benchmark"@en ,
               "Benchmark"@fr .



#################################################################


proj:ContainerizedCode rdf:type owl:Class ;
    rdfs:subClassOf proj:Software ;
    skos:prefLabel "Containerized Codes" ;
    rdfs:comment "A containerized code created as a product" .    

proj:ScientificComputing rdf:type owl:Class ;
    rdfs:subClassOf proj:ContainerizedCode ;
    skos:prefLabel "Scientific Computing" ;
    rdfs:comment "Containerized software used for scientific computing" .

proj:Visualization rdf:type owl:Class ;
    rdfs:label "Visualization" ;
    rdfs:comment "Contenarized software used for visualization" ;
    rdfs:subClassOf proj:ContainerizedCode .


##----------------------------------
proj:Software rdf:type owl:Class ;
    rdfs:subClassOf
        proj:Resource ,
        proj:ProjectOutput ;
    rdfs:label "Software"@en ,
               "Logiciel"@fr ;
    rdfs:comment "A software package, application or computational code used or produced by a project."@en .

proj:SoftwareLicense rdf:type owl:Class ;
    rdfs:label "Software license"@en ;
    rdfs:comment "The licensing or distribution model of a software resource."@en .

proj:SoftwareCategory rdf:type owl:Class ;
    rdfs:label "Software category"@en ,
               "Catégorie de logiciel"@fr ;
    rdfs:comment "Functional category describing the main purpose of a software resource."@en .

proj:SoftwareDistribution rdf:type owl:Class ;
    rdfs:label "Software distribution"@en ;
    rdfs:comment "How the software is distributed or deployed."@en .

proj:ContainerImage rdf:type owl:Class ;
    rdfs:subClassOf proj:SoftwareDistribution , proj:ProjectOutput ;
    rdfs:label "Container image"@en , "Image de conteneur"@fr ;
    rdfs:comment """A packaged, reproducible execution environment (such as an Apptainer/Singularity SIF file or Docker image) containing a specific software installation along with its dependencies."""@en ,
                 """Un environnement d'exécution encapsulé et reproductible (tel qu'un fichier SIF Apptainer/Singularity ou une image Docker) contenant une installation logicielle spécifique ainsi que ses dépendances."""@fr .

proj:SoftwareSystem rdf:type owl:Class ;
    rdfs:subClassOf 
        proj:Software ,
        proj:Resource ,
        proj:ProjectOutput ;
    rdfs:label "Software system"@en ,
               "Système logiciel"@fr ;
    rdfs:comment """A comprehensive software system composed of multiple interacting 
    components, microservices, databases, or standalone applications working together 
    to achieve a unified operational purpose.
    Within the project context, a Software System functions both as an infrastructure 
    Resource and as a tangible deliverable (ProjectOutput)."""@en ,
                 """Un système logiciel complet composé de plusieurs composants, 
    microservices, bases de données ou applications autonomes travaillant ensemble pour 
    atteindre un objectif opérationnel unifié.
    Dans le contexte du projet, un système logiciel fonctionne à la fois comme une 
    ressource d'infrastructure et comme un livrable tangible (ProjectOutput)."""@fr .

proj:SoftwareComponent rdf:type owl:Class ;
    rdfs:subClassOf proj:Software ;
    rdfs:label "Software component"@en ,
               "Composant logiciel"@fr ;
    rdfs:comment """
    A discrete, encapsulated, and replaceable software module, microservice, library, 
    or component that forms a structural part of a larger software system. It encapsulates 
    specific functionality and exposes well-defined interfaces."""@en ,
    """Un module logiciel, un microservice, une bibliothèque ou un composant discret, 
    encapsulé et remplaçable qui constitue une partie structurelle d'un système logiciel 
    plus vaste. Il encapsule des fonctionnalités spécifiques et expose des interfaces bien 
    définies."""@fr .

proj:hasSoftwareComponent rdf:type owl:ObjectProperty ;
    rdfs:domain proj:SoftwareSystem ;
    rdfs:range proj:SoftwareComponent ;
    rdfs:label "has software component"@en ,
               "a pour composant logiciel"@fr ;
    rdfs:comment """Links a parent software system to one of its constituent software 
    components, modules, or services, establishing a part-whole compositional hierarchy 
    within the project's software architecture."""@en ,
                 """Relie un système logiciel parent à l'un de ses composants, modules 
    ou services logiciels constitutifs, établissant ainsi une hiérarchie de composition 
    tout-partie au sein de l'architecture logicielle du projet."""@fr .

proj:isSoftwareComponentOf rdf:type owl:ObjectProperty ;
    owl:inverseOf proj:hasSoftwareComponent ;
    rdfs:domain proj:SoftwareComponent ;
    rdfs:range  proj:SoftwareSystem ;
    rdfs:label "is software component of"@en , "est un composant logiciel de"@fr ;
    rdfs:comment """Links a software component, plugin, or module back to the parent software system or framework it belongs to, extends, or integrates with."""@en ,
                 """Relie un composant logiciel, un plugin ou un module au système logiciel ou framework parent auquel il appartient, qu'il étend ou avec lequel il s'intègre."""@fr .

proj:Dataset rdf:type owl:Class ;
    rdfs:subClassOf
        proj:Resource ,
        proj:ProjectOutput ;
    rdfs:label "Dataset"@en ,
               "Jeu de données"@fr ;
    rdfs:comment "A structured collection of data used or produced during the project."@en .


proj:ContainerTechnology rdf:type owl:Class ;
    rdfs:label "Container technology"@en .

proj:HardwareSupport rdf:type owl:Class ;
    rdfs:label "Hardware support"@en .

### --- Personnel Type Class ---
proj:PersonnelType rdf:type owl:Class ;
    rdfs:label "Personnel Type" ;
    rdfs:comment "A category describing the type of personnel in a research project (e.g., Scientifique, Engineer, Postdoc)." .

#-------------------


# -- Competences ----------------------------------------------------------

proj:Competence rdf:type owl:Class ;
    rdfs:label   "Competence"@en , "Compétence"@fr ;
    rdfs:comment "A skill, domain expertise or technical ability."@en .


proj:DataManagement rdf:type owl:Class ;
    rdfs:label "Data Management" ;
    rdfs:comment "Competences related to data management and curation" ;
    rdfs:subClassOf proj:Competence .

proj:Computational rdf:type owl:Class ;
    rdfs:label "Computational" ;
    rdfs:comment "Competences related to computational methods and tools" ;
    rdfs:subClassOf proj:Competence .

proj:Methodological rdf:type owl:Class ;
    rdfs:label "Methodological" ;
    rdfs:comment "Competences related to methodological approaches" ;
    rdfs:subClassOf proj:Competence .




# -- Call for Projects -------------------------------------------------------
# Class, properties and canonical instances
proj:Call rdf:type owl:Class ;
    rdfs:label "Call for projects"@en , "Appel à projets"@fr ;
    rdfs:comment "A funding call through which AAP projects are selected."@en .

proj:callYear rdf:type owl:DatatypeProperty ;
    rdfs:domain proj:Call ;
    rdfs:range xsd:gYear ;
    rdfs:label "call year"@en .

proj:selectedInCall rdf:type owl:ObjectProperty ;
    rdfs:domain proj:AAPProject ;
    rdfs:range proj:Call ;
    rdfs:label "selected in call"@en .

proj:Call2023
    rdf:type proj:Call ;
    rdfs:label "AAP 2023"@en ;
    proj:callYear "2023"^^xsd:gYear .

proj:Call2024
    rdf:type proj:Call ;
    rdfs:label "AAP 2024"@en ;
    proj:callYear "2024"^^xsd:gYear .

# ─────────────────────────────────────────────
#  Object Properties
# ─────────────────────────────────────────────

proj:encapsulatesSoftware rdf:type owl:ObjectProperty ;
    rdfs:domain proj:ContainerImage ;
    rdfs:range  proj:Software ;
    rdfs:label  "encapsulates software"@en , "encapsule el logiciel"@fr ;
    rdfs:comment """Links a container image or package to the original software suite installed and bundled inside it."""@en ,
                 """Relie une image de conteneur ou un paquet au logiciel d'origine installé et inclus à l'intérieur."""@fr .

proj:isUsedForDevelopment rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Resource ;
    rdfs:range proj:ProjectOutput ;
    rdfs:label "is used for development"@en ,
               "est utilisé pour le développement"@fr ;
    rdfs:comment """
    Links a software resource or system to a development activity, application domain, 
    or output category for which it is utilized (e.g., plugin development, automated 
    workflows)."""@en ,
    """Relie une ressource ou un système logiciel à une activité de développement, un 
    domaine d'application ou une catégorie de livrable para lequel il est utilisé (par 
    exemple, le développement de plugins, les flux de travail automatisés)."""@fr .

proj:worksOn rdf:type owl:ObjectProperty ;
    rdfs:domain proj:ResearchPerson ;
    rdfs:range proj:WorkPackage ;
    rdfs:comment "Relates a person to the work package they work on" ;
    rdfs:label "worksOn" .

proj:hasPersonnelType rdf:type owl:ObjectProperty ;
    rdfs:label "has personnel type" ;
    rdfs:comment "Links a Person to one or more PersonnelType categories." ;
    rdfs:domain proj:ResearchPerson ;
    rdfs:range proj:PersonnelType .


proj:hasComponent rdf:type owl:ObjectProperty ;
    rdfs:label "has component"@en ;
    rdfs:comment "Relates a composite resource to one of its constituent software or hardware components."@en .

proj:isHostedOn rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Database ;
    rdfs:range  proj:DatabaseInfrastructure ;
    rdfs:label  "is hosted on"@en , "est hébergé sur"@fr ;
    rdfs:comment """Links an individual database instance to the database infrastructure that runs and serves it online."""@en ,
                 """Relie une instance de base de données spécifique à l'infrastructure de base de données qui l'exécute et la sert en ligne."""@fr .

#proj:hasAssociatedProject rdf:type owl:ObjectProperty ;
#    rdfs:domain proj:Database ;
#    rdfs:range  proj:Project ;
#    rdfs:label  "has data provider project"@en ,
#                "a pour projet fournisseur de données"@fr ;
#    rdfs:comment """Identifies the collaborative partner project that collected, generated, or provided the domain content populating this database."""@en ,
###                 """Identifie le projet partenaire collaboratif qui a collecté, généré ou fourni le contenu métier alimentant cette base de données."""@fr .

proj:hasDeployerProject rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Database ;
    rdfs:range  proj:Project ;
    rdfs:label  "has deployer project"@en ,
                "a pour projet déployeur"@fr ;
    rdfs:comment """Identifies the project (e.g., the Diamond project) responsible for instantiating, configuring, and putting the database online within the infrastructure."""@en ,
                 """Identifie le projet (par exemple, le projet Diamond) responsable de l'instanciation, de la configuration et de la mise en ligne de la base de données au sein de l'infrastructure."""@fr .



# Software -> hasLicense -> SoftwareLicense
proj:hasLicense rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Software ;
    rdfs:range proj:SoftwareLicense ;
    rdfs:label "has software license"@en .

proj:hasCategory rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Software ;
    rdfs:range proj:SoftwareCategory ;
    rdfs:label "has category"@en .

proj:hasDistribution rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Software ;
    rdfs:range proj:SoftwareDistribution ;
    rdfs:label "has distribution"@en .

proj:usesContainerTechnology rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Software ;
    rdfs:range proj:ContainerTechnology ;
    rdfs:label "uses container technology"@en .

proj:supportsHardware rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Software ;
    rdfs:range proj:HardwareSupport ;
    rdfs:label "supports hardware"@en .

# Programme → Funding
proj:hasFunding rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:Program ;
    rdfs:range   proj:Funding ;
    rdfs:label   "has funding"@en .

# Programme → Person / Organisation (lead & colead)
proj:hasLeadPerson rdf:type owl:ObjectProperty ;
     rdfs:label   "has co-lead"@en ;
    rdfs:comment "Co-lead. Same domain range flexibility as proj:hasLead."@en .

# Programme → Platform / Project
proj:hasPlatform rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:Program ;
    rdfs:range   proj:Platform ;
    rdfs:label   "has platform"@en .

proj:hasProject rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:Program ;
    rdfs:range   proj:Project ;
    rdfs:comment "All projects developped in the platform." ; 
    rdfs:label   "has project (targeted or AAP)"@en .


proj:hasAssociatedProject a owl:ObjectProperty ;
    rdfs:label "has associated project"@en ,
               "a pour projet associé"@fr ;
    rdfs:comment "Generic relationship linking a resource or entity to an associated project."@en ,
                 "Relation générique reliant une ressource ou une entité à un projet associé."@fr .

proj:hasPlatformAssociatedProject rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf proj:hasAssociatedProject ;
    rdfs:domain proj:Platform ;
    rdfs:range  proj:Project ;
    rdfs:label  "has platform associated project"@en ,
                "a pour projet associé à la plateforme"@fr ;
    rdfs:comment "Links a platform to a project associated with its operation or context."@en ,
                 "Relie une plateforme à un projet associé à son fonctionnement ou son contexte."@fr .

proj:hasDatabaseAssociatedProject rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf proj:hasAssociatedProject ;
    rdfs:domain proj:Database ;
    rdfs:range  proj:Project ;
    rdfs:label  "has database associated project"@en ,
                "a pour projet associé à la base de données"@fr ;
    rdfs:comment """Links a database to an associated partner project that contributed to its creation by providing the domain data, defining the data model/schema (often in collaboration with the host project), or both."""@en ,
                 """Relie une base de données à un projet partenaire associé qui a contribué à sa création en fournissant les données métier, en définissant le modèle de données/schéma (souvent en collaboration avec le projet hôte), ou les deux."""@fr .
                 
#proj:hasAssociatedProject rdf:type owl:ObjectProperty ;
#    rdfs:domain  proj:Platform ;
#    rdfs:range   proj:Project ;
##    rdfs:label   "has platform project"@en ;
#    rdfs:comment "Projects associated to this platform."@en .

proj:hasPlatformLeadProject rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf proj:hasAssociatedProject ;
    rdfs:label   "has platform lead project"@en ;
    rdfs:comment "The 1 or 2 lead projects for this platform."@en .

proj:hasMaterialType rdf:type owl:ObjectProperty ;
    rdfs:domain  [ owl:unionOf ( proj:CharacterizationPlatform proj:SynthesisPlatform ) ] ;
    rdfs:range   proj:MaterialType ;
    rdfs:label   "has material type"@en .    
    
proj:hasDimension rdf:type owl:ObjectProperty ;
    rdfs:domain   proj:SynthesisPlatform  ;
    rdfs:range   proj:Dimension ;
    rdfs:label   "has dimension"@en .    

proj:hasTechnique rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:CharacterizationPlatform  ;
    rdfs:range   proj:TechniqueType ;
    rdfs:label   "has characterization technique"@en .    

# Project → WorkPackage / Organization
proj:hasWorkPackage rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:Project ;
    rdfs:range   proj:WorkPackage ;
    rdfs:label   "has work package"@en .

proj:hasOrganization rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:Project ;
    rdfs:range   proj:Organization ;
    rdfs:label   "has organization"@en .

# WorkPackage → deliverables, tasks, tools, products, people
proj:hasDeliverable rdf:type owl:ObjectProperty ;
    rdfs:domain  [ owl:unionOf ( proj:Task proj:WorkPackage ) ] ;
    rdfs:range   proj:Deliverable ;
    rdfs:label   "has deliverable"@en .


proj:hasTask rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:WorkPackage ;
    rdfs:range   proj:Task ;
    rdfs:label   "has task"@en .

proj:usesResource rdf:type owl:ObjectProperty ;
    rdfs:domain  [ owl:unionOf ( proj:Task proj:WorkPackage ) ]  ;
    rdfs:range   proj:Resource ;
    rdfs:label   "uses resource"@en .

proj:producesOutput rdf:type owl:ObjectProperty ;
    rdfs:domain  [ owl:unionOf ( proj:Task proj:WorkPackage ) ]  ;
    rdfs:range   proj:ProjectOutput ;
    rdfs:label   "produces output"@en .
    
proj:containsOutput rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:Deliverable  ;
    rdfs:range   proj:ProjectOutput ;
    rdfs:label   "contains product"@en .

proj:hasContributor rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:WorkPackage ;
    rdfs:range   proj:ResearchPerson ;
    rdfs:label   "has contributor"@en .

proj:hasLeadOrganization rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:WorkPackage ;
    rdfs:range   proj:Organization ;
    rdfs:label   "has lead organization"@en .

# Person → Competence / Membership
proj:hasCompetence rdf:type owl:ObjectProperty ;
    rdfs:domain  [ owl:unionOf ( proj:ResearchPerson proj:WorkPackage proj:Project) ] ;
    rdfs:range   proj:Competence ;
    rdfs:label   "has competence"@en .

proj:gathersCompetence rdf:type owl:ObjectProperty ;
    rdfs:domain  [ owl:unionOf ( proj:WorkPackage proj:Project) ] ;
    rdfs:range   proj:Competence ;
    rdfs:label   "gathers competence"@en ;
    rdfs:comment "Indicates that a Work Package or Project gatheres specific competence to be carried out." .


proj:hasMembership rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:ResearchPerson ;
    rdfs:range   proj:Membership ;
    rdfs:label   "has membership"@en .

proj:memberOf rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:Membership ;
    rdfs:range   proj:Organization ;
    rdfs:label   "member of"@en .

proj:memberRole rdf:type owl:DatatypeProperty ;
    rdfs:domain  proj:Membership ;
    rdfs:range   xsd:string ;
    rdfs:label   "member role"@en .

# Project ↔ Person (generic participation)
proj:involvesPerson rdf:type owl:ObjectProperty ;
    rdfs:domain  proj:Project ;
    rdfs:range   proj:ResearchPerson ;
    rdfs:label   "involves person"@en .


# ─────────────────────────────────────────────
#  Datatype Properties
# ─────────────────────────────────────────────
proj:employedBy rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Person ;
    rdfs:range proj:Organization ;
    skos:prefLabel "employed by" ;
    owl:inverseOf proj:employs .

proj:employs rdf:type owl:ObjectProperty ;
    skos:prefLabel "employs" ;
    rdfs:domain proj:Organization ;
    rdfs:range proj:Person ;
    owl:inverseOf proj:employedBy .


proj:identifier rdf:type owl:DatatypeProperty ;
    rdfs:label   "identifier"@en ;
    rdfs:range   xsd:string .

proj:acronym rdf:type owl:DatatypeProperty ;
    rdfs:label   "Acronym"@en ;
    rdfs:range   xsd:string .

#proj:acronym rdf:type owl:DatatypeProperty ;
#    rdfs:domain proj:Organization ;
#    rdfs:range xsd:string ;
#    rdfs:label "Acronym"@en .

proj:fullName rdf:type owl:DatatypeProperty ;
#    rdfs:domain proj:Organization ;
    rdfs:domain  [ owl:unionOf ( proj:Organization proj:Project proj:Program) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Full name"@en .    

proj:description rdf:type owl:DatatypeProperty ;
    rdfs:label   "description"@en ;
    rdfs:range   xsd:string .

proj:startDate rdf:type owl:DatatypeProperty ;
    rdfs:label   "start date"@en ;
    rdfs:range   xsd:date .

proj:endDate rdf:type owl:DatatypeProperty ;
    rdfs:label   "end date"@en ;
    rdfs:range   xsd:date .

proj:documentationURL rdf:type owl:DatatypeProperty ;
    rdfs:label   "documentation URL"@en ;
    rdfs:range   xsd:anyURI .

proj:fundingAmount rdf:type owl:DatatypeProperty ;
    rdfs:domain  proj:Funding ;
    rdfs:range   xsd:decimal ;
    rdfs:label   "funding amount"@en .

proj:fundingCurrency rdf:type owl:DatatypeProperty ;
    rdfs:domain  proj:Funding ;
    rdfs:range   xsd:string ;
    rdfs:label   "funding currency"@en .

proj:fundingSource rdf:type owl:DatatypeProperty ;
    rdfs:domain  proj:Funding ;
    rdfs:range   xsd:string ;
    rdfs:label   "funding source"@en .

proj:country rdf:type owl:DatatypeProperty ;
    rdfs:domain proj:Organization ;
    rdfs:range xsd:string ;
    rdfs:label "Country"@en .

# University - Research institute - Laboratory- Infrastructure - Company
proj:organizationType rdf:type owl:DatatypeProperty ;
    rdfs:domain proj:Organization ;
    rdfs:range xsd:string ;
    rdfs:label "Organization type"@en .

proj:partOfOrganization rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Organization ;
    rdfs:range proj:Organization .

#proj:hasOrcid rdf:type owl:ObjectProperty ;
#    rdfs:domain proj:ResearchPerson ;
#    rdfs:range xsd:anyURI ;
#    rdfs:label   "ORCID"@en .

proj:hasOrcid rdf:type owl:ObjectProperty ;
    rdfs:domain proj:ResearchPerson ;
    rdfs:label "ORCID identifier"@en .

#proj:rorID rdf:type owl:DatatypeProperty ;
#    rdfs:domain  proj:Organization ;
#    rdfs:range   xsd:anyURI ;
#    rdfs:label   "ROR identifier"@en .
proj:hasROR rdf:type owl:ObjectProperty ;
    rdfs:domain proj:Organization ;
    rdfs:label "ROR identifier"@en .

proj:goalDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain  proj:Platform ;
    rdfs:range   xsd:string ;
    rdfs:label   "goal description"@en .

proj:dueDate rdf:type owl:DatatypeProperty ;
    rdfs:domain  proj:Deliverable ;
    rdfs:range   xsd:date ;
    rdfs:label   "due date"@en .

proj:deliverableType rdf:type owl:DatatypeProperty ;
    rdfs:domain  proj:Deliverable ;
    rdfs:range   xsd:string ;
    rdfs:label   "deliverable type"@en .

proj:competenceLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain  proj:Competence ;
    rdfs:range   xsd:string ;
    rdfs:label   "competence level"@en ;
    rdfs:comment "E.g. beginner / intermediate / expert."@en .

proj:competenceDomain rdf:type owl:DatatypeProperty ;
    rdfs:domain  proj:Competence ;
    rdfs:range   xsd:string ;
    rdfs:label   "competence domain"@en .

proj:wpNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain  proj:WorkPackage ;
    rdfs:range   xsd:integer ;
    rdfs:label   "WP number"@en .

proj:hasURL rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "A URL pointing to the official webpage or external resource of an entity." ;
    skos:prefLabel "has URL" .

proj:isCurrentMember rdf:type owl:DatatypeProperty ;
    rdfs:domain proj:ResearchPerson ;
    rdfs:range xsd:boolean ;
    skos:prefLabel "is current member" ;
    rdfs:comment "Indicates if the person is currently active in the project." .

proj:joinDate rdf:type owl:DatatypeProperty ;
        rdfs:domain proj:ResearchPerson ;
        rdfs:range xsd:gYearMonth ;
        rdfs:comment "Date when the person joined the project" ;
        rdfs:label "join date" .

proj:leftDate rdf:type owl:DatatypeProperty ;
        rdfs:domain proj:ResearchPerson ;
        rdfs:range xsd:gYearMonth ;
        rdfs:comment "Date when the person left the project" ;
        rdfs:label "left date" .



# ─────────────────────────────────────────────
#  Canonical Instances
# ─────────────────────────────────────────────

# -->> Software License <<----------------------------------------------
proj:OpenSource
    rdf:type proj:SoftwareLicense ;
    rdfs:label "Open source"@en .

proj:Commercial
    rdf:type proj:SoftwareLicense ;
    rdfs:label "Commercial"@en .

proj:Private
    rdf:type proj:SoftwareLicense ;
    rdfs:label "Private"@en .



# -->> Software Category <<----------------------------

proj:ScientificComputing rdf:type owl:NamedIndividual ,
                                  proj:SoftwareCategory ;
    rdfs:label "Scientific computing"@en ;
    rdfs:comment "Software primarily intended for numerical simulation, modelling or scientific computation."@en .


proj:Visualization rdf:type owl:NamedIndividual ,
                            proj:SoftwareCategory ;
    rdfs:label "Visualization"@en ;
    rdfs:comment "Software intended for visualization, rendering or interactive exploration of scientific data."@en .


proj:MachineLearning rdf:type owl:NamedIndividual ,
                              proj:SoftwareCategory ;
    rdfs:label "Machine learning"@en ;
    rdfs:comment "Software dedicated to machine learning and artificial intelligence."@en .


proj:WorkflowManagement rdf:type owl:NamedIndividual ,
                                 proj:SoftwareCategory ;
    rdfs:label "Workflow management"@en ;
    rdfs:comment "Software for orchestrating scientific workflows and computational pipelines."@en .


proj:PreProcessing rdf:type owl:NamedIndividual ,
                            proj:SoftwareCategory ;
    rdfs:label "Pre-processing"@en .


proj:PostProcessing rdf:type owl:NamedIndividual ,
                             proj:SoftwareCategory ;
    rdfs:label "Post-processing"@en .


# -->> Software Distribution <<--------------------------
proj:Containerized rdf:type owl:NamedIndividual ,
                            proj:SoftwareDistribution ;
    rdfs:label "Containerized"@en ;
    rdfs:comment "Distributed as a software container (Docker, Apptainer, Singularity, etc.)."@en .


proj:Native rdf:type owl:NamedIndividual ,
                     proj:SoftwareDistribution ;
    rdfs:label "Native installation"@en .


proj:WebApplication rdf:type owl:NamedIndividual ,
                             proj:SoftwareDistribution ;
    rdfs:label "Web application"@en .


# -->> Container Technology <<-------------------------------

proj:Docker rdf:type owl:NamedIndividual ,
                     proj:ContainerTechnology ;
    rdfs:label "Docker"@en .


proj:Apptainer rdf:type owl:NamedIndividual ,
                        proj:ContainerTechnology ;
    rdfs:label "Apptainer"@en .


proj:Singularity rdf:type owl:NamedIndividual ,
                          proj:ContainerTechnology ;
    rdfs:label "Singularity"@en .


# -->> Hardware Support <<-----------------------------

proj:CPU rdf:type owl:NamedIndividual , proj:HardwareSupport ;
    rdfs:label "CPU"@en .


proj:GPU rdf:type owl:NamedIndividual , proj:HardwareSupport ;
    rdfs:label "GPU"@en .

proj:MultiGPU rdf:type owl:NamedIndividual , proj:HardwareSupport ;
    rdfs:label "Multi-GPU"@en .






